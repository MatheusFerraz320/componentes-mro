---
import { products } from "../data/site";
import TechnicalImage from "./TechnicalImage.astro";
---

<section id="produtos" class="scroll-mt-16 bg-neutral-light py-16 md:py-24">
  <div class="container-x">
    <h1 class="mb-12 text-center font-display text-4xl font-bold text-primary-dark">
      LINHA DE COMPONENTES - <span class="text-accent-orange">MRO</span>
    </h1>
    <p class="mb-12 text-center font-display text-lg font-bold text-primary-dark">
      SOLUÇÕES PARA MANUTENÇÃO E REPOSIÇÃO INDUSTRIAL
    </p>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((product) => (
        <article class="panel-tech card-tech flex flex-col rounded p-5">
          <div class="mb-4 overflow-hidden rounded border border-neutral-gray-200 bg-neutral-light shadow-inner">
            <TechnicalImage variant={product.asset} alt={product.title} />
          </div>

          <h3 class="mb-2 font-display text-lg font-bold leading-snug text-primary-dark">
            {product.title}
          </h3>
          <p class="mb-4 text-sm leading-relaxed text-ink-soft">
            {product.desc}
          </p>

          <p class="kicker mb-2 text-primary-dark/50">Tipos identificados</p>
          <ul class="mb-5 space-y-1.5">
            {product.tipos.map((tipo) => (
              <li class="flex items-center gap-2 text-sm text-ink-soft">
                <span
                  class="h-px w-3 shrink-0 bg-accent-orange"
                  aria-hidden="true"
                ></span>
                {tipo}
              </li>
            ))}
          </ul>

          {(product.marca || product.marcas) && (
            <div class="mb-6 mt-auto border-t border-neutral-gray-100 pt-4">
              <p class="kicker mb-2 text-primary-dark/50">Marca identificada</p>
              <p class="font-display text-sm font-bold tracking-wide text-primary-dark">
                {product.marca ?? product.marcas!.join(" · ")}
              </p>
            </div>
          )}

          <a href="#orcamento" class="btn-outline w-full rounded px-4 py-2.5">
            {product.cta}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
