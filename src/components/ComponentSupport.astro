---
import { support } from '../data/site'
import Icon from './Icon.astro'
---

<section id="suporte" class="scroll-mt-16 bg-neutral-gray-100 py-16 md:py-24">
  <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 class="mb-3 font-display text-3xl font-extrabold leading-tight text-primary-dark md:text-4xl">
        IDENTIFICAÇÃO PELA APLICAÇÃO
      </h2>
      <p class="mb-8 max-w-lg text-lg font-semibold text-ink-soft">{support.title}</p>
      <p class="mb-8 max-w-lg text-base text-ink-soft">{support.text}</p>

      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {support.items.map((item) => (
          <li class="card-tech flex flex-col items-center gap-2 rounded p-4 text-center">
            <Icon name={item.icon} class="h-10 w-10 text-accent-orange" />
            <span class="text-sm font-semibold text-primary-dark">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative overflow-hidden rounded bg-accent-orange p-8 text-white shadow-sm md:p-10">
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-white/15 blur-2xl"
        aria-hidden="true"
      ></div>
      <p class="kicker mb-4 text-white/80">APOIO TÉCNICO</p>
      <h3 class="mb-3 font-display text-2xl font-bold leading-tight">
        Envie os dados do componente e receba o direcionamento
      </h3>
      <p class="mb-8 text-white/90">
        Foto, referência, medidas ou a aplicação da máquina. Nosso time identifica e responde com a
        especificação correta.
      </p>
      <a
        href={support.cta.href}
        class="inline-flex items-center justify-center gap-2 rounded bg-neutral-light px-6 py-3 font-display text-sm font-bold tracking-wide text-accent-orange transition-colors hover:bg-primary-dark hover:text-neutral-light"
      >
        {support.cta.label}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
