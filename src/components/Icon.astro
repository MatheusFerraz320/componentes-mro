}

const { name, class: className = "h-6 w-6", id } = Astro.props;
const nodes = icons[name] ?? [];
---

<svg
  id={id}
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {nodes.map((n) =>
    n.t === "c" ? (
      <circle cx={n.cx} cy={n.cy} r={n.r} />
    ) : n.t === "r" ? (
      <rect x={n.x} y={n.y} width={n.width} height={n.height} rx={n.rx} />
    ) : (
      <path d={n.d} />
    ),
  )}
</svg>
