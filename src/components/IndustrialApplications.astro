---
import { applications } from '../data/site'
import TechnicalImage from './TechnicalImage.astro'
---

<section id="aplicacoes" class="scroll-mt-16 bg-neutral-light py-16 md:py-24">
  <div class="container-x">
    <h2 class="mb-3 text-center font-display text-3xl font-extrabold leading-tight text-primary-dark md:text-4xl">
      APLICAÇÕES
    </h2>
    <p class="mb-10 text-center text-base font-semibold text-ink-soft md:text-lg">
      COMPONENTES PARA EQUIPAMENTOS INDUSTRIAIS
    </p>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6 lg:gap-6">
      {applications.map((app) => (
        <article class="card-tech flex flex-col items-center rounded p-4 text-center hover:border-accent-orange/60">
          <div class="mb-4 w-full overflow-hidden rounded border border-neutral-gray-200 bg-neutral-light shadow-inner">
            <TechnicalImage variant={app.asset} alt={app.title} />
          </div>
          <h3 class="mb-2 font-display text-sm font-bold leading-snug text-primary-dark">
            {app.title}
          </h3>
          <p class="text-xs leading-relaxed text-ink-soft">{app.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
