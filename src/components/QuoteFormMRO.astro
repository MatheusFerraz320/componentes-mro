---
import { form, site } from "../data/site";
import Icon from "./Icon.astro";

const contactItems = [
  { icon: "phone", label: "Telefone", value: site.phone },
  { icon: "whatsapp", label: "WhatsApp", value: site.whatsapp },
  { icon: "mail", label: "E-mail", value: site.email },
  { icon: "clock", label: "Horário", value: site.hours },
];
---

<section id="orcamento" class="scroll-mt-16 bg-neutral-light py-16 md:py-24">
  <div class="container-x">
    <p class="kicker mb-3 text-accent-orange">07 // COTAÇÃO E SUPORTE</p>
    <h2 class="mb-12 font-display text-3xl font-bold text-primary-dark">
      {form.title}
    </h2>

    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="lg:col-span-2">
        <p class="mb-8 max-w-md text-base leading-relaxed text-ink-soft">
          {form.intro}
        </p>

        <h3 class="kicker mb-4 text-primary-dark/50">O que acontece depois</h3>
        <ol class="mb-10 space-y-4">
          {form.steps.map((step, i) => (
            <li class="flex items-start gap-4">
              <span class="kicker flex h-9 w-9 shrink-0 items-center justify-center rounded border border-accent-orange text-accent-orange">
                {`0${i + 1}`}
              </span>
              <span class="pt-1.5 text-sm font-medium leading-relaxed text-primary-dark/90">
                {step}
              </span>
            </li>
          ))}
        </ol>

        <h3 class="kicker mb-4 text-primary-dark/50">Canais de atendimento</h3>
        <ul class="space-y-3">
          {contactItems.map((item) => (
            <li class="flex items-center gap-3 text-sm text-ink-soft">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded border border-neutral-gray-200 text-primary-dark">
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              <span>
                <span class="block text-xs font-semibold text-primary-dark/60">
                  {item.label}
                </span>
                {item.value}
              </span>
            </li>
          ))}
        </ul>

        <div class="mt-8 flex items-start gap-3 rounded border-l-2 border-accent-orange bg-neutral-gray-100 p-4">
          <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-accent-orange" />
          <p class="text-sm leading-relaxed text-primary-dark/90">
            {site.brand} — presença em {site.region}, com atendimento para
            empresas e aplicações industriais em todo o país.
          </p>
        </div>
      </div>

      <form
        class="rounded border border-neutral-gray-200 bg-neutral-gray-100 p-6 md:p-8 lg:col-span-3"
        novalidate
      >
        <p class="mb-6 text-sm text-ink-soft">
          Campos marcados com <span class="required-dot">*</span> são
          obrigatórios.
        </p>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {form.fields.map((field) => {
            const colClass = field.span === "full" ? "sm:col-span-2" : "";
            return (
              <div class={colClass}>
                <label for={field.name} class="label-field">
                  {field.label}
                  {field.required && <span class="required-dot">*</span>}
                </label>

                {field.type === "select" ? (
                  <select
                    id={field.name}
                    name={field.name}
                    class="input-field"
                    required={field.required ?? false}
                  >
                    <option value="" disabled selected>
                      Selecione…
                    </option>
                    {field.options!.map((option) => (
                      <option value={option}>{option}</option>
                    ))}
                  </select>
                ) : field.type === "textarea" ? (
                  <textarea
                    id={field.name}
                    name={field.name}
                    class="input-field min-h-28 resize-y"
                    rows={4}
                    placeholder={field.placeholder}
                    required={field.required ?? false}
                  ></textarea>
                ) : field.type === "file" ? (
                  <div>
                    <div class="flex items-center gap-3 rounded border border-neutral-gray-200 bg-neutral-light p-3">
                      <Icon
                        name="upload"
                        class="h-5 w-5 shrink-0 text-accent-orange"
                      />
                      <input
                        id={field.name}
                        name={field.name}
                        type="file"
                        accept="image/*,.pdf"
                        class="w-full text-sm text-ink-soft file:mr-3 file:rounded file:border-0 file:bg-primary-dark file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-neutral-light"
                      />
                    </div>
                    {field.hint && (
                      <p class="mt-1.5 text-xs text-ink-soft/75">
                        {field.hint}
                      </p>
                    )}
                  </div>
                ) : (
                  <input
                    id={field.name}
                    name={field.name}
                    type={field.type}
                    class="input-field"
                    placeholder={field.placeholder}
                    min={field.type === "number" ? 0 : undefined}
                    required={field.required ?? false}
                  />
                )}
              </div>
            );
          })}
        </div>

        <button
          type="submit"
          class="btn-primary mt-8 w-full rounded px-6 py-3.5 text-base"
        >
          {form.cta}
        </button>

        <p class="mt-3 text-sm text-ink-soft/80">{form.note}</p>
      </form>
    </div>
  </div>
</section>
