---
import { features } from "../data/site";
import Icon from "./Icon.astro";
---

<section
  id="diferenciais"
  class="relative scroll-mt-16 overflow-hidden bg-neutral-gray-100"
>
  <div class="container-x py-16 md:py-24">
    <h2 class="mb-3 text-center font-display text-3xl font-extrabold leading-tight text-primary-dark md:text-4xl">
      POR QUE ESCOLHER A PIONEIRA?
    </h2>
    <p class="mb-4 text-center text-base font-semibold text-ink-soft md:text-lg">
      APOIO PARA SUA NECESSIDADE DE MANUTENÇÃO
    </p>
    <div
      class="mx-auto mb-12 h-1 w-20 bg-accent-orange"
      aria-hidden="true"
    ></div>

    <ul
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-5 lg:[perspective:1600px]"
    >
      {features.map((feature, i) => (
        <li>
          <article class="card-3d h-full">
            <div class="card-3d-face flex h-full flex-col rounded-lg p-6">
              <span
                class="pointer-events-none absolute right-4 top-3 font-display text-4xl font-black leading-none text-primary-dark/10"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>

              <span
                class="absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-accent-orange/70 to-transparent"
                aria-hidden="true"
              ></span>

              <span
                class="mb-5 flex h-12 w-12 items-center justify-center rounded border border-accent-orange/40 bg-white/70 text-accent-orange"
              >
                <Icon name={feature.icon} class="h-6 w-6" />
              </span>

              <h3 class="mb-1 font-display text-lg font-bold text-primary-dark">
                {feature.title}
              </h3>
              <p class="kicker mb-3 text-accent-orange/90">{feature.sub}</p>
              <p class="mt-auto text-sm leading-relaxed text-ink-soft">
                {feature.desc}
              </p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .card-3d {
    transform-style: preserve-3d;
    transition: transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .card-3d::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    z-index: 0;
    background: linear-gradient(
      180deg,
      var(--color-primary-dark-800),
      var(--color-primary-dark-900)
    );
    box-shadow: 0 24px 40px -18px rgb(13 29 48 / 0.55);
    transform: translate3d(6px, 10px, -18px);
    transition:
      transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 320ms ease;
  }

  .card-3d:hover {
    transform: rotateX(5deg) translateY(-10px) translateZ(0);
  }

  .card-3d:hover::before {
    transform: translate3d(8px, 16px, -32px);
    box-shadow: 0 32px 52px -18px rgb(13 29 48 / 0.62);
  }

  .card-3d-face {
    position: relative;
    z-index: 1;
    transform: translateZ(2px);
    background-image: linear-gradient(
      180deg,
      #ffffff 0%,
      #f5f8fc 72%,
      #e9eff6 100%
    );
    border: 1px solid #cdd5df;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 1),
      inset 0 -1px 0 rgb(0 33 71 / 0.06);
  }
</style>