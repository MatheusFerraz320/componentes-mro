---
import { features } from "../data/site";
import Icon from "./Icon.astro";
---

<section id="diferenciais" class="scroll-mt-16 bg-neutral-light py-16 md:py-24">
  <div class="container-x">
    <p class="kicker mb-3 text-center text-accent-orange">
      06 // POR QUE A PIONEIRA?
    </p>
    <h2 class="mb-10 text-center font-display text-3xl font-bold text-primary-dark">
      APOIO PARA SUA NECESSIDADE DE MANUTENÇÃO
    </h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:grid-cols-5">
      {features.map((feature) => (
        <article class="card-tech flex flex-col rounded p-6">
          <Icon name={feature.icon} class="mb-4 h-8 w-8 text-accent-orange" />
          <h3 class="mb-1 font-display text-lg font-bold text-primary-dark">
            {feature.title}
          </h3>
          <p class="kicker mb-3 text-accent-orange/90">{feature.sub}</p>
          <p class="text-sm leading-relaxed text-ink-soft">{feature.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
