---
interface Props {
  uid: string;
  label: string;
  class?: string;
}

const { uid, label, class: className = "h-auto w-full" } = Astro.props;
const g = `${uid}-`;
---

<svg
  class={className}
  viewBox="0 0 320 240"
  role="img"
  aria-label={`Ilustração técnica ${label}`}
>
  <defs>
    <linearGradient id={`${g}bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f4f7fb" />
      <stop offset="1" stop-color="#dfe6ef" />
    </linearGradient>
    <linearGradient id={`${g}steel`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f7fafc" />
      <stop offset="1" stop-color="#c3cdda" />
    </linearGradient>
    <linearGradient id={`${g}steel2`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9fadbd" />
      <stop offset="1" stop-color="#6b7a8b" />
    </linearGradient>
    <linearGradient id={`${g}rubber`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2a3d57" />
      <stop offset="1" stop-color="#14263f" />
    </linearGradient>
    <radialGradient id={`${g}floor`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#0e2a4a" stop-opacity="0.16" />
      <stop offset="1" stop-color="#0e2a4a" stop-opacity="0" />
    </radialGradient>
    <marker
      id={`${g}arr`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M0 0 L10 5 L0 10 z" fill="#ff6b00" />
    </marker>
  </defs>

  <rect width="320" height="240" fill={`url(#${g}bg)`} />

  <g stroke="#002147" stroke-opacity="0.05">
    {Array.from({ length: 11 }, (_, i) => (i + 1) * 20).map((y) => {
      return <line x1="0" y1={y} x2="320" y2={y} />;
    })}
  </g>
  <g stroke="#002147" stroke-opacity="0.05">
    {Array.from({ length: 15 }, (_, i) => (i + 1) * 20).map((x) => {
      return <line x1={x} y1="0" x2={x} y2="240" />;
    })}
  </g>

  <ellipse cx="160" cy="202" rx="112" ry="16" fill={`url(#${g}floor)`} />

  <slot />

  <line
    x1="160"
    y1="18"
    x2="160"
    y2="46"
    stroke="#ff6b00"
    stroke-opacity="0.45"
    stroke-dasharray="3 4"
  />
  <line
    x1="160"
    y1="188"
    x2="160"
    y2="218"
    stroke="#ff6b00"
    stroke-opacity="0.45"
    stroke-dasharray="3 4"
  />
  <line
    x1="20"
    y1="120"
    x2="52"
    y2="120"
    stroke="#ff6b00"
    stroke-opacity="0.45"
    stroke-dasharray="3 4"
  />
  <line
    x1="268"
    y1="120"
    x2="300"
    y2="120"
    stroke="#ff6b00"
    stroke-opacity="0.45"
    stroke-dasharray="3 4"
  />

  <path d="M9 22 V9 H22" fill="none" stroke="#ff6b00" stroke-width="1.5" />
  <path
    d="M311 218 V231 H298"
    fill="none"
    stroke="#ff6b00"
    stroke-width="1.5"
  />

  <text
    x="14"
    y="228"
    font-family="JetBrains Mono, monospace"
    font-size="8"
    font-weight="700"
    letter-spacing="2"
    fill="#002147"
  >
    {label}
  </text>
  <text
    x="306"
    y="228"
    text-anchor="end"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    letter-spacing="1.5"
    fill="#a0a0a0"
  >
    RENDER 3D · PLACEHOLDER
  </text>
</svg>
