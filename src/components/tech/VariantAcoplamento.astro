---
import BaseFrame from './BaseFrame.astro'

interface Props {
  class?: string
}

const uid = 'acoplamento'
const g = `${uid}-`
const { class: className } = Astro.props
---

<BaseFrame uid={uid} label="ACOPLAMENTO ELÁSTICO" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="206" cy="122" r="58" fill={`url(#${g}steel2)`} />
    <circle cx="206" cy="122" r="46" fill="none" />
    <circle cx="206" cy="122" r="16" fill="#dfe6ef" />

    <circle cx="112" cy="132" r="55" fill={`url(#${g}steel)`} />
    <circle cx="112" cy="132" r="42" fill="none" opacity="0.5" />
    <circle cx="112" cy="132" r="16" fill={`url(#${g}steel2)`} />

    <circle cx="112" cy="132" r="5" fill="#dfe6ef" />
    {[0, 90, 180, 270].map((a) => (
      <circle
        cx={112 + 38 * Math.cos((a * Math.PI) / 180)}
        cy={132 + 38 * Math.sin((a * Math.PI) / 180)}
        r="4.5"
        fill={`url(#${g}steel2)`}
      />
    ))}
  </g>

  <g stroke="#ff6b00" stroke-width="2" fill="none">
    <path d="M146 116 l-10 6 l4 12" />
    <path d="M178 122 l10 -8" opacity="0.7" />
  </g>
  <ellipse cx="180" cy="118" rx="11" ry="9" fill="#ff6b00" opacity="0.85" />

  <line
    x1="48"
    y1="202"
    x2="272"
    y2="202"
    stroke="#ff6b00"
    stroke-width="1"
    marker-start={`url(#${g}arr)`}
    marker-end={`url(#${g}arr)`}
  />
  <text
    x="160"
    y="196"
    text-anchor="middle"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    fill="#ff6b00"
  >
    D1 + D2
  </text>
</BaseFrame>
