---
import BaseFrame from './BaseFrame.astro'

interface Props {
  class?: string
}

const uid = 'bomba'
const g = `${uid}-`
const { class: className } = Astro.props
---

<BaseFrame uid={uid} label="BOMBA CENTRÍFUGA" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="52" y="168" width="216" height="14" rx="6" fill={`url(#${g}steel2)`} />

    <circle cx="124" cy="116" r="52" fill={`url(#${g}steel)`} />
    <circle cx="124" cy="116" r="38" fill="none" opacity="0.55" />
    <circle cx="124" cy="116" r="17" fill={`url(#${g}rubber)`} />
    <path
      d="M124 99 a28 28 0 0 1 22 35"
      fill="none"
      stroke="#dfe6ef"
      stroke-width="3"
      stroke-linecap="round"
    />
    <path
      d="M96 116 a28 28 0 0 1 14 -26"
      fill="none"
      stroke={`url(#${g}steel2)`}
      stroke-width="3"
      stroke-linecap="round"
    />

    <path
      d="M176 82 h14 v16 h42 a8 8 0 0 1 8 8 v12 a8 8 0 0 1-8 8 h-56 v-44 z"
      fill={`url(#${g}steel2)`}
    />
    <rect x="232" y="86" width="8" height="26" rx="2" fill={`url(#${g}steel)`} />
    <circle cx="190" cy="90" r="6" fill={`url(#${g}steel2)`} />
    {[0, 1, 2, 3].map((i) => (
      <circle cx={238 + i * 5} cy="99" r="1.6" fill="#dfe6ef" />
    ))}

    <rect x="74" y="84" width="10" height="26" rx="3" fill={`url(#${g}steel2)`} />
    <line
      x1="70"
      y1="96"
      x2="86"
      y2="96"
      stroke="#ff6b00"
      stroke-width="1.5"
      stroke-dasharray="2 3"
    />
  </g>

  <text
    x="160"
    y="230"
    text-anchor="middle"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    fill="#ff6b00"
  >
    CARCAÇA · ROTOR · FLANGES
  </text>
</BaseFrame>
