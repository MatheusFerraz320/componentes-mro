---
import BaseFrame from './BaseFrame.astro'

interface Props {
  class?: string
}

const uid = 'bucha'
const g = `${uid}-`
const { class: className } = Astro.props
---

<BaseFrame uid={uid} label="BUCHA DE FIXAÇÃO" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <ellipse cx="160" cy="182" rx="82" ry="16" fill={`url(#${g}steel2)`} />
    <path
      d="M78 182 l16 -52 a10 10 0 0 1 9-7 h116 a10 10 0 0 1 9 7 l16 52"
      fill={`url(#${g}steel)`}
    />
    <ellipse cx="160" cy="130" rx="66" ry="14" fill={`url(#${g}steel2)`} />
    <ellipse cx="160" cy="130" rx="40" ry="8" fill={`url(#${g}rubber)`} />
    <ellipse cx="160" cy="130" rx="18" ry="3.5" fill="#dfe6ef" />

    <path d="M82 132 a68 14 0 0 0 18 8" fill="none" stroke={`url(#${g}steel)`} stroke-width="5" />
    <line
      x1="160"
      y1="114"
      x2="160"
      y2="130"
      stroke="#ff6b00"
      stroke-width="1.5"
      stroke-dasharray="2 3"
    />

    <path d="M96 160 h14 v20 h-14 z" fill="#dfe6ef" />
    <path d="M204 160 h16 v20 h-16 z" fill="#dfe6ef" />
  </g>

  <line
    x1="60"
    y1="204"
    x2="260"
    y2="204"
    stroke="#ff6b00"
    stroke-width="1"
    marker-start={`url(#${g}arr)`}
    marker-end={`url(#${g}arr)`}
  />
  <text
    x="160"
    y="198"
    text-anchor="middle"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    fill="#ff6b00"
  >
    CÔNICO 1:12
  </text>
</BaseFrame>
