---
import BaseFrame from "./BaseFrame.astro";

interface Props {
  class?: string;
}

const uid = "hero";
const g = `${uid}-`;
const { class: className } = Astro.props;
---

<BaseFrame uid={uid} label="CONJUNTO MRO" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <ellipse cx="168" cy="200" rx="116" ry="14" fill={`url(#${g}floor)`} />

    <g>
      <circle cx="226" cy="94" r="34" fill={`url(#${g}steel2)`} />
      <circle cx="226" cy="94" r="20" fill={`url(#${g}rubber)`} />
      <circle cx="226" cy="94" r="9" fill="#dfe6ef" />
      <path
        d="M196 74 a30 30 0 0 1 26 -8"
        fill="none"
        stroke="#ff6b00"
        stroke-opacity="0.7"
        stroke-width="1.2"
      />
    </g>

    <g>
      <rect
        x="74"
        y="180"
        width="188"
        height="14"
        rx="4"
        fill={`url(#${g}steel2)`}
      />
      <path
        d="M96 96 h106 a10 10 0 0 1 10 10 v74 h-126 v-74 a10 10 0 0 1 10-10 z"
        fill={`url(#${g}steel)`}
      />
      <path d="M101 104 h96 v26 h-96 z" fill="#e8edf3" opacity="0.65" />
      <circle cx="160" cy="144" r="36" fill={`url(#${g}steel2)`} />
      <circle cx="160" cy="144" r="24" fill={`url(#${g}rubber)`} />
      <circle cx="160" cy="144" r="10" fill="#dfe6ef" />
      <circle cx="112" cy="100" r="5" fill={`url(#${g}steel2)`} />
      <circle cx="208" cy="100" r="5" fill={`url(#${g}steel2)`} />
    </g>

    <g>
      <circle cx="118" cy="66" r="26" fill={`url(#${g}steel)`} />
      <circle cx="118" cy="66" r="15" fill={`url(#${g}steel2)`} />
      <circle cx="118" cy="66" r="6" fill="#dfe6ef" />
    </g>

    <line
      x1="70"
      y1="84"
      x2="96"
      y2="62"
      stroke="#ff6b00"
      stroke-opacity="0.6"
      stroke-width="1"
      stroke-dasharray="2 4"
    />
    <line
      x1="140"
      y1="186"
      x2="188"
      y2="120"
      stroke="#ff6b00"
      stroke-opacity="0.6"
      stroke-width="1"
      stroke-dasharray="2 4"
    />
  </g>
</BaseFrame>
