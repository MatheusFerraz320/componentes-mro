---
import BaseFrame from "./BaseFrame.astro";

interface Props {
  class?: string;
}

const uid = "mancal";
const g = `${uid}-`;
const { class: className } = Astro.props;
---

<BaseFrame uid={uid} label="MANCAL DE ROLOS" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect
      x="55"
      y="168"
      width="250"
      height="20"
      rx="6"
      fill={`url(#${g}steel2)`}
    />
    <circle cx="84" cy="178" r="5" fill="#dfe6ef" />
    <circle cx="276" cy="178" r="5" fill="#dfe6ef" />

    <path
      d="M92 88 h136 a14 14 0 0 1 14 14 v64 a6 6 0 0 1-6 6 h-152 a6 6 0 0 1-6-6 v-64 a14 14 0 0 1 14-14 z"
      fill={`url(#${g}steel)`}
    />
    <path d="M98 96 h124 v28 h-124 z" fill="#e8edf3" opacity="0.65" />

    <circle cx="116" cy="92" r="6" fill={`url(#${g}steel2)`} />
    <circle cx="204" cy="92" r="6" fill={`url(#${g}steel2)`} />

    <circle cx="160" cy="136" r="42" fill={`url(#${g}steel2)`} />
    <circle cx="160" cy="136" r="28" fill={`url(#${g}rubber)`} />
    <circle cx="160" cy="136" r="12" fill="#dfe6ef" />

    <line
      x1="84"
      y1="200"
      x2="276"
      y2="200"
      stroke="#ff6b00"
      stroke-width="1"
      marker-start={`url(#${g}arr)`}
      marker-end={`url(#${g}arr)`}
    />
  </g>
  <text
    x="180"
    y="196"
    text-anchor="middle"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    fill="#ff6b00"
  >
    A-A
  </text>
</BaseFrame>
