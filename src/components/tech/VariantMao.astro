---
import BaseFrame from './BaseFrame.astro'

interface Props {
  class?: string
}

const uid = 'mao'
const g = `${uid}-`
const { class: className } = Astro.props
---

<BaseFrame uid={uid} label="COMPONENTE EM APLICAÇÃO" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <ellipse cx="160" cy="198" rx="96" ry="12" fill={`url(#${g}floor)`} />

    <path
      d="M64 128 q-4 58 44 64 h58 q42 -8 32 -58 l-12 -14 q-14 -12 -30 -12 h-52 q-24 0 -40 20 z"
      fill={`url(#${g}steel2)`}
    />

    <path
      d="M88 104 q-2 -34 24 -36 24 -2 24 28 v6 l-8 -4 q-4 -28 -18 -28 -16 0 -14 34 z"
      fill={`url(#${g}steel)`}
    />
    <path
      d="M124 64 q2 -24 22 -26 20 -2 20 26 v10 l-10 -2 q0 -26 -10 -28 -12 0 -14 30 z"
      fill={`url(#${g}steel)`}
    />
    <path
      d="M156 58 q2 -24 24 -24 t22 26 l-12 2 q-2 -22 -12 -22 -8 0 -10 28 z"
      fill={`url(#${g}steel)`}
    />
    <path
      d="M188 56 q4 -22 26 -14 18 8 14 34 l-12 -4 q6 -20 -8 -24 -10 -4 -14 22 z"
      fill={`url(#${g}steel)`}
    />
    <path
      d="M50 142 q-2 34 22 38 20 4 18 -22 q-2 -18 -16 -16 -12 0 -24 0 z"
      fill={`url(#${g}steel)`}
    />

    <circle cx="150" cy="150" r="24" fill={`url(#${g}steel)`} />
    <circle cx="150" cy="150" r="24" fill="none" stroke={`url(#${g}steel2)`} stroke-width="4" />
    <circle cx="150" cy="150" r="12" fill={`url(#${g}rubber)`} />
    <circle cx="150" cy="150" r="6" fill="#dfe6ef" />
  </g>

  <text
    x="160"
    y="230"
    text-anchor="middle"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    fill="#ff6b00"
  >
    OPERADOR · INSTALAÇÃO · MANUTENÇÃO
  </text>
</BaseFrame>
