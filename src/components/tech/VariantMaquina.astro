---
import BaseFrame from "./BaseFrame.astro";

interface Props {
  class?: string;
}

const uid = "maquina";
const g = `${uid}-`;
const { class: className } = Astro.props;
---

<BaseFrame uid={uid} label="MÁQUINA INDUSTRIAL" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect
      x="62"
      y="84"
      width="196"
      height="84"
      rx="10"
      fill={`url(#${g}steel)`}
    />
    <rect
      x="62"
      y="84"
      width="196"
      height="26"
      rx="10"
      fill={`url(#${g}steel2)`}
      opacity="0.9"
    />

    <circle cx="216" cy="144" r="20" fill={`url(#${g}steel2)`} />
    <circle
      cx="216"
      cy="144"
      r="12"
      fill="none"
      stroke="#dfe6ef"
      stroke-width="2"
    />
    <line
      x1="216"
      y1="124"
      x2="216"
      y2="136"
      stroke="#ff6b00"
      stroke-width="2"
    />
    <line
      x1="204"
      y1="144"
      x2="208"
      y2="144"
      stroke="#ff6b00"
      stroke-width="2"
    />

    <circle cx="84" cy="130" r="10" fill={`url(#${g}steel2)`} />
    <circle cx="236" cy="130" r="10" fill={`url(#${g}steel2)`} />
    <rect
      x="176"
      y="130"
      width="14"
      height="6"
      rx="3"
      fill={`url(#${g}steel2)`}
    />
    <rect
      x="158"
      y="130"
      width="12"
      height="6"
      rx="3"
      fill={`url(#${g}steel2)`}
    />

    <rect
      x="100"
      y="168"
      width="120"
      height="10"
      rx="5"
      fill={`url(#${g}steel)`}
    />
    <rect
      x="140"
      y="178"
      width="40"
      height="12"
      rx="3"
      fill={`url(#${g}steel2)`}
    />

    <line
      x1="80"
      y1="60"
      x2="240"
      y2="60"
      stroke="#ff6b00"
      stroke-opacity="0.6"
      stroke-width="1"
      stroke-dasharray="3 4"
    />
  </g>

  <text
    x="160"
    y="230"
    text-anchor="middle"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    fill="#ff6b00"
  >
    CARCAÇA · PAINEL · FIXAÇÃO
  </text>
</BaseFrame>
