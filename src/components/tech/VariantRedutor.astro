---
import BaseFrame from './BaseFrame.astro'

interface Props {
  class?: string
}

const uid = 'redutor'
const g = `${uid}-`
const { class: className } = Astro.props
---

<BaseFrame uid={uid} label="REDUTOR DE VELOCIDADE" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="62" y="92" width="196" height="74" rx="10" fill={`url(#${g}steel)`} />
    <rect x="62" y="92" width="196" height="24" rx="10" fill={`url(#${g}steel2)`} opacity="0.85" />
    {[0, 1, 2, 3, 4].map((i) => (
      <circle cx={84 + i * 38} cy="68" r="3.5" fill="#dfe6ef" />
    ))}

    <circle cx="200" cy="150" r="42" fill="none" stroke={`url(#${g}steel2)`} stroke-width="5" />
    <circle
      cx="200"
      cy="150"
      r="30"
      fill="none"
      stroke="#ff6b00"
      stroke-opacity="0.8"
      stroke-width="1.5"
      stroke-dasharray="4 4"
    />
    <circle cx="200" cy="150" r="16" fill={`url(#${g}rubber)`} />

    <rect x="92" y="166" width="26" height="12" rx="3" fill={`url(#${g}steel2)`} />
    <circle cx="196" cy="80" r="16" fill={`url(#${g}steel2)`} />
    <circle cx="196" cy="80" r="6" fill="#dfe6ef" />
    <line
      x1="76"
      y1="102"
      x2="244"
      y2="102"
      stroke="#ff6b00"
      stroke-opacity="0.5"
      stroke-width="1"
      stroke-dasharray="3 4"
    />
  </g>

  <text
    x="160"
    y="230"
    text-anchor="middle"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    fill="#ff6b00"
  >
    EIXO ENTRADA · ENGRENAGENS · EIXO SAÍDA
  </text>
</BaseFrame>
