---
import BaseFrame from "./BaseFrame.astro";

interface Props {
  class?: string;
}

const uid = "transportador";
const g = `${uid}-`;
const { class: className } = Astro.props;
---

<BaseFrame uid={uid} label="TRANSPORTADOR" class={className}>
  <g
    stroke="#002147"
    stroke-opacity="0.55"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path
      d="M44 168 L64 96 h192 l20 72 z"
      fill="none"
      stroke={`url(#${g}steel2)`}
      stroke-width="6"
    />
    <path d="M64 96 h192" stroke={`url(#${g}steel)`} stroke-width="5" />

    {[100, 160, 220].map((x) => (
      <g>
        <circle cx={x} cy={104} r="26" fill={`url(#${g}steel2)`} />
        <circle cx={x} cy={104} r="26" fill="none" />
        <circle cx={x} cy={104} r="7" fill="#dfe6ef" />
        {[0, 90, 180, 270].map((a) => {
          const r = (a * Math.PI) / 180;
          return (
            <circle
              cx={x + 19 * Math.cos(r)}
              cy={104 + 19 * Math.sin(r)}
              r="2.5"
              fill="#dfe6ef"
            />
          );
        })}
      </g>
    ))}

    <line
      x1="58"
      y1="86"
      x2="262"
      y2="86"
      stroke="#ff6b00"
      stroke-width="1.5"
      stroke-dasharray="2 3"
    />

    <rect x="96" y="130" width="8" height="24" fill={`url(#${g}steel)`} />
    <rect x="216" y="130" width="8" height="24" fill={`url(#${g}steel)`} />
  </g>

  <text
    x="160"
    y="230"
    text-anchor="middle"
    font-family="JetBrains Mono, monospace"
    font-size="7"
    fill="#ff6b00"
  >
    ROLETES · TAMBORES · GUIAS
  </text>
</BaseFrame>
